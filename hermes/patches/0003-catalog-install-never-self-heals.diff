+#!/usr/bin/env python3
+"""Offline tests: a Hermes catalog install never heals itself.
+
+`hermes plugins install valorbrain` writes `.hermes-catalog.json` beside the
+plugin. The catalog pins an exact reviewed sha and forbids self-updating code
+(plugin-catalog/README.md, rule 3), so with that file present the plugin never
+starts the connect launcher's heal, even with node, the launcher and a new pin.
+Without it (a connect install) the heal still runs.
+
+The heal child is a fake `node` on PATH that records its argv.
+
+Run: PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s packages/hermes-plugin/tests -v
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+import types
+import unittest
+from pathlib import Path
+
+PLUGIN = Path(__file__).resolve().parents[1] / "__init__.py"
+ENV_KEYS = ("VALORBRAIN_HOOKS_MODE", "PATH", "HOME")
+
+
+def _load_plugin_from(directory: Path, name: str):
+    agent_mod = types.ModuleType("agent")
+    provider_mod = types.ModuleType("agent.memory_provider")
+
+    class MemoryProvider:  # the plugin only subclasses it
+        pass
+
+    provider_mod.MemoryProvider = MemoryProvider
+    agent_mod.memory_provider = provider_mod
+    sys.modules.setdefault("agent", agent_mod)
+    sys.modules.setdefault("agent.memory_provider", provider_mod)
+    spec = importlib.util.spec_from_file_location(name, directory / "__init__.py")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class CatalogInstallHealTest(unittest.TestCase):
+    def setUp(self):
+        self._env = {k: os.environ.get(k) for k in ENV_KEYS}
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+        os.environ["HOME"] = str(self.root)
+        bindir = self.root / "bin"
+        bindir.mkdir()
+        os.environ["PATH"] = str(bindir)
+        os.environ["VALORBRAIN_HOOKS_MODE"] = "hosted"
+        self.heal_log = self.root / "heal-calls.log"
+        node = bindir / "node"
+        node.write_text(f'#!/bin/sh\necho "$@" >> "{self.heal_log}"\n')
+        node.chmod(0o755)
+        connect = self.root / ".valorbrain" / "bin" / "connect"
+        connect.mkdir(parents=True)
+        (connect / "launcher.mjs").write_text("// fake launcher\n")
+        (connect / "current.json").write_text(json.dumps({"version": "1.0.0"}))
+
+    def tearDown(self):
+        for k, v in self._env.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        self._tmp.cleanup()
+
+    def _install(self, name: str, catalog: bool):
+        target = self.root / ".hermes" / "plugins" / name
+        target.mkdir(parents=True)
+        shutil.copy(PLUGIN, target / "__init__.py")
+        if catalog:
+            (target / ".hermes-catalog.json").write_text(json.dumps({
+                "catalog_name": "valorbrain", "repo": "https://github.com/ValorBrain/valorbrain-cli",
+                "sha": "0" * 40, "tier": "community",
+            }))
+        return _load_plugin_from(target, f"_hermes_plugin_catalog_{name}")
+
+    def _heal_calls(self, wait: float) -> list:
+        deadline = time.time() + wait
+        while time.time() < deadline:
+            if self.heal_log.exists():
+                break
+            time.sleep(0.02)
+        return self.heal_log.read_text().splitlines() if self.heal_log.exists() else []
+
+    def test_catalog_install_never_heals(self):
+        mod = self._install("catalog", catalog=True)
+        mod._maybe_heal({"client_pin": {"version": "9.9.9"}})
+        self.assertEqual(self._heal_calls(wait=1.0), [])
+
+    def test_connect_install_still_heals(self):
+        mod = self._install("connect", catalog=False)
+        mod._maybe_heal({"client_pin": {"version": "9.9.9"}})
+        calls = self._heal_calls(wait=5.0)
+        self.assertEqual(len(calls), 1)
+        self.assertTrue(calls[0].endswith("heal --harness=hermes"))
+
+
+if __name__ == "__main__":
+    unittest.main()
