     return (os.environ.get(_HOOKS_MODE_ENV) or "").strip().lower() == _HOOKS_MODE_HOSTED
 
 
+# Gateway sessions (Telegram, Discord, Slack, ...) carry the platform user they
+# serve in `initialize(user_id=...)`. A `vbm_` token is one person's memory, so
+# by default the provider stays off there: otherwise every person talking to the
+# bot would recall and write as the token's owner. VALORBRAIN_GATEWAY_USERS lists
+# the platform user ids this token speaks for (comma-separated; `*` = everyone,
+# for a bot only its owner uses).
+_GATEWAY_USERS_ENV = "VALORBRAIN_GATEWAY_USERS"
+
+
+def _gateway_user_allowed(user_id: Any, user_id_alt: Any = None) -> bool:
+    raw = os.environ.get(_GATEWAY_USERS_ENV) or ""
+    allowed = {v.strip() for v in raw.split(",") if v.strip()}
+    if "*" in allowed:
+        return True
+    ids = {str(v).strip() for v in (user_id, user_id_alt) if v is not None} - {""}
+    return bool(allowed & ids)
+
+
